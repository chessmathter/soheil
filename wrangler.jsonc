{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "soheil",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b255018c-b6db-4081-8d42-d77123119301","database_name": "soheil" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "8775973785eb47d8b86ddf9c97c858bb" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
